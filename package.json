{
  "name": "redis-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix backend run dev",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "start": "npm --prefix backend start",
    "redis:start": "docker compose up -d --wait redis",
    "dev:local": "npm run redis:start && npm run dev",
    "test:integration": "npm --prefix backend run test:integration"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
