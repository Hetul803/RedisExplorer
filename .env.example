# Server settings (never expose Redis credentials with a VITE_ prefix)
NODE_ENV=development
PORT=3001
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
# Exact frontend origin; comma-separated only if multiple origins are needed.
# In production, leave empty for same-origin hosting or set your frontend URL.
CLIENT_ORIGIN=http://localhost:5173
# Browser API base: relative for same-origin, full HTTPS URL for separate hosting.
VITE_API_URL=/api
# Local Vite development proxy only; omit to use http://localhost:$PORT.
API_PROXY_TARGET=http://localhost:3001
